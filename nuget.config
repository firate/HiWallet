<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Makinedeki global feed'ler (DevExpress vb.) bu repoya sızmasın.
       Central package management birden fazla kaynakla NU1507 veriyor; ayrıca
       build'in nerede çalıştığından bağımsız olarak aynı paketleri çözmesini istiyoruz. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
