# stripe-fake — kart sağlayıcısının yerinde duran servis. CANLIDA YOK.
#
# Rider'da sağ üstten ortamı seç (fakes/http-client.env.json). Depoda "local" var;
# stack başka bir makinedeyse kendi ortamını http-client.private.env.json'a ekle.
#
# Asıl akışta ödemeyi card-topup açıyor (müşterinin kartla yüklemesi, limit payından
# sonra) ve müşteri ödeme sayfasında karar veriyor; adımlar docs/verify-compose.md
# "Kartla yükleme"de. Bu dosya sahte sağlayıcının kendi API'sini tek başına deniyor:
# buradan açılan ödemenin referansı bir kart yüklemesi değil, sonucu card-topup'ta
# dead-letter'a düşer ve cüzdana para gitmez.

### 1. Ödeme aç
# Beklenen: 201, status "requires_payment" ve paymentUrl. Aynı reference ile ikinci
# istek yeni ödeme açmaz, ilkini 200 ile döner; farklı tutarla 409.
POST {{stripeFake}}/v1/payments
Content-Type: application/json

{
  "reference": "{{$uuid}}",
  "amount": 100,
  "currency": "TRY",
  "returnUrl": "http://localhost:8102/kart-yukleme",
  "expiresAt": "2030-01-01T00:00:00+00:00"
}

> {%
    client.global.set("paymentId", response.body.id);
    client.global.set("reference", response.body.reference);
%}

### 2. Ödemeyi kimliğiyle sorgula
GET {{stripeFake}}/v1/payments/{{paymentId}}

### 3. Ödemeyi açanın referansıyla sorgula
# card-topup'ın taraması bu yolu kullanıyor: açılışın cevabı kaybolduysa ödeme
# kimliğini bilmiyor. Bu referansla ödeme yoksa 404.
GET {{stripeFake}}/v1/payments?reference={{reference}}

### 4. Ödeme sayfası
# Tarayıcıda aç: "Öde" ya da "Vazgeç". Karar müşteriyi returnUrl'e yolluyor (303) ve
# sonucu topup-webhook'a imzalı webhook'la gönderiyor. Süresi dolan ödeme için webhook
# GİTMİYOR; sonucu 2 ya da 3 söylüyor (status "expired").
GET {{stripeFake}}/odeme/{{paymentId}}

### 5. Health check
GET {{stripeFake}}/health/ready
