<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- KART SAĞLAYICISININ YERİNDE DURAN SAHTE SERVİS (decisions.md madde 35).

         Canlıda YOK: yerine sağlayıcının kendi ödeme API'si, ödeme sayfası ve webhook'ları geçiyor.

         BANKADAN FARKI: yalnızca PARA GİRİŞİ. Stripe'tan para çıkmıyor, o yüzden
         ne transfer ucu var ne callback alıcısı. Ledger'da da nostro'su yok —
         nostro bir banka hesabı ve Stripe banka değil; parayı bizim banka
         hesabımıza yatırıyor (SystemAccounts).

         VERİTABANI YOK, bilerek: ödemeler bellekte. Süreç ölürse açık ödemeler kaybolur;
         kart yüklemesi servisi sorduğunda ödemeyi bulamaz ve yüklemeyi kapatır. -->

    <PropertyGroup>
        <RootNamespace>HiWallet.Stripe.Fake</RootNamespace>
        <AssemblyName>HiWallet.Stripe.Fake</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation"/>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shared\Shared.Infrastructure\Shared.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HiWallet.IntegrationTests"/>
    </ItemGroup>

</Project>
