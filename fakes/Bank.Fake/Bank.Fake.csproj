<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- BANKANIN YERİNDE DURAN SAHTE SERVİS (decisions.md madde 35).

         KLASÖRÜ `fakes/`, `src/` DEĞİL. Üretimde deploy edilen hiçbir şey bu
         klasörden çıkmıyor; sınır dizin seviyesinde görünür durumda. `src/`
         altındaki hiçbir proje buraya referans VERMEZ — verirse üretim kodu
         sahte bir kuruma bağlanmış olur.

         Üretimde bu proje YOK: yerine gerçek bankanın kendi ucu geçiyor ve bu klasör
         siliniyor. Bizim kodumuz olan taraf `BankAdapter`; ayrımın ölçütü "test amaçlı
         mı" değil, "başka bir kurumun yerine mi duruyor".

         SINIRIN GERÇEK OLMASI İÇİN: wallet'ı görmüyor, orchestrator'ı görmüyor,
         RabbitMQ'ya hiç bağlanmıyor ve KENDİ veritabanında duruyor. Gerçek bir banka
         da bunların hiçbirine erişemezdi. `Shared.Contracts`'a referansı bile yok —
         bizim mesaj sözleşmelerimiz onu ilgilendirmiyor. -->

    <PropertyGroup>
        <!-- Eski BankService.Fake ".Fake"i isim alanından çıkarıyordu; burada
             çıkarılmıyor. O zamanki gerekçe "gerçek entegrasyon yazılınca using
             satırları değişmesin"di ve artık geçersiz: gerçek entegrasyon ayrı bir
             projede (BankAdapter), bu proje bütün olarak silinecek. İsim alanında
             durması, sahte tarafa dokunduğunu her dosyada görünür kılıyor. -->
        <RootNamespace>HiWallet.Bank.Fake</RootNamespace>
        <AssemblyName>HiWallet.Bank.Fake</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="FluentValidation"/>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions"/>
        <PackageReference Include="AspNetCore.HealthChecks.NpgSql"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Shared.Contracts YOK, bilerek: sahte banka bizim mesaj sözleşmelerimizi
             görmemeli. Shared.Infrastructure yalnızca observability ve sağlık ucu
             için — bunlar altyapı, iş sözleşmesi değil. -->
        <ProjectReference Include="..\..\src\Shared\Shared.Infrastructure\Shared.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HiWallet.IntegrationTests"/>
    </ItemGroup>

</Project>
