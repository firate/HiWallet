# bank-fake — bankanın yerinde duran servis. ÜRETİMDE YOK.
#
# Rider'da sağ üstten ortamı seç (fakes/http-client.env.json). Depoda "local" var;
# stack başka bir makinedeyse kendi ortamını http-client.private.env.json'a ekle.
#
# İki bölüm var:
#   A. Bankanın kendisi: bank-adapter'ın konuştuğu endpoint'ler. Normalde sen
#      çağırmazsın; burada sahtenin nasıl davrandığını görmek için.
#   B. Kumanda: bankada olmayan, test için var olan endpoint'ler.
#
# Uçtan uca çekim senaryoları ayrı dosyada: fakes/akislar.http

# ============================================================================
# A. Bankanın kendisi
# ============================================================================

### A1. Transfer başlat
# Beklenen: 202 ve status "pending". Banka "aldım" diyor, "gönderdim" demiyor.
# Aynı Idempotency-Key ile tekrar gönderirsen aynı bankReference ve
# "replayed": true döner.
POST {{bankFake}}/v1/transfers
Content-Type: application/json
Idempotency-Key: {{$uuid}}

{
  "clientReference": "{{$uuid}}",
  "amount": 100,
  "currency": "TRY",
  "destinationIban": "TR330006100519786457841326"
}

> {%
    client.global.set("bankReference", response.body.bankReference);
%}

### A2. Transfer durumu
# İlk birkaç saniye "pending", sonra "succeeded". Süreyi BANK_SETTLEMENT_DELAY
# belirliyor. bank-adapter'ın mutabakat taraması tam olarak bunu soruyor.
GET {{bankFake}}/v1/transfers/{{bankReference}}

### A3. Anahtarsız request
# Beklenen: 400. Banka anahtarsız transfer açmıyor.
POST {{bankFake}}/v1/transfers
Content-Type: application/json

{
  "clientReference": "{{$uuid}}",
  "amount": 100,
  "currency": "TRY",
  "destinationIban": "TR330006100519786457841326"
}

# ============================================================================
# B. Kumanda — gerçek bankada YOK
# ============================================================================

### B1. Senaryo kur: kalıcı red
# clientReference = saga id. Senaryo, aynı clientReference ile gelen transferde
# uygulanıyor — B1a'da görürsün.
POST {{bankFake}}/v1/scenarios
Content-Type: application/json

{ "clientReference": "deneme-red", "outcome": "Failure" }

### B1a. B1'i dene
# Beklenen: 202 ve "pending" — banka reddi de kabul anında söylemiyor. Birkaç
# saniye sonra A2 ile bak: "failed" ve failureReason dolu.
# Sahte banka yeniden başlatılırsa senaryo silinir, B1'i tekrar koş.
POST {{bankFake}}/v1/transfers
Content-Type: application/json
Idempotency-Key: {{$uuid}}

{
  "clientReference": "deneme-red",
  "amount": 100,
  "currency": "TRY",
  "destinationIban": "TR330006100519786457841326"
}

> {%
    client.global.set("bankReference", response.body.bankReference);
%}

### B2. Senaryo kur: iki kez geçici hata, sonra kabul
# İlk iki transfer request'i 503 alır ve transfer HİÇ açılmaz; üçüncüsü kabul edilir.
POST {{bankFake}}/v1/scenarios
Content-Type: application/json

{ "clientReference": "deneme-gecici", "outcome": "TransientFailure", "transientFailures": 2 }

### B3. Senaryo kur: gecikmeli başarı
POST {{bankFake}}/v1/scenarios
Content-Type: application/json

{ "clientReference": "deneme-gecikme", "outcome": "DelayedSuccess", "delayMilliseconds": 15000 }

### B4. B2'yi dene — bu request'i üç kez koş
# 1. ve 2. seferde 503, 3. seferde 202.
POST {{bankFake}}/v1/transfers
Content-Type: application/json
Idempotency-Key: {{$uuid}}

{
  "clientReference": "deneme-gecici",
  "amount": 100,
  "currency": "TRY",
  "destinationIban": "TR330006100519786457841326"
}

### B5. Senaryonun durumu
# attempts, request'in kaç kez geldiğini gösteriyor. B4'ten sonra 3 olmalı.
# Bellekte tutuluyor: sahte banka yeniden başladıysa 404 döner. B2'yi yeniden
# koşmak sayaçları sıfırlar.
GET {{bankFake}}/v1/scenarios/deneme-gecici

### B6. Toplama hesabına havale
# Gerçek bankada bu endpoint YOK: havaleyi müşteri kendi bankasından gönderir.
# Banka parayı açıklamaya bakmadan kabul edip bank-webhook'a bildiriyor. Cüzdana
# geçmesi için açıklamada müşterinin hesap numarası, senderNationalId'de onun
# doğrulamada verdiği kimlik numarası olmalı; yoksa para askıya düşer.
# "notify": false bildirimi göndermez; havaleyi hesap hareketi taraması bulur.
POST {{bankFake}}/v1/incoming-transfers
Content-Type: application/json

{
  "amount": 250,
  "currency": "TRY",
  "description": "{{accountNumber}}",
  "senderName": "Ayşe Yılmaz",
  "senderIban": "TR330006100519786457841326",
  "senderNationalId": "10000000146"
}

### B6b. Hesap hareketleri
# Hesap hareketi taramasının okuduğu endpoint.
GET {{bankFake}}/v1/incoming-transfers?from=2026-01-01T00:00:00Z&to=2030-01-01T00:00:00Z

### B7. Health check
GET {{bankFake}}/health/ready
