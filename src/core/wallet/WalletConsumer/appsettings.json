{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ConnectionStrings ve RabbitMq .env / User Secrets'tan gelir, buraya YAZILMAZ
  // (baseline.md madde 1).

  // Doğrulama seviyesine göre AYLIK çekim ve yükleme limiti. Yalnızca bireysel hesaba
  // uygulanıyor; iade edilen çekim sayılmıyor. Transfer ve ödeme limitleri wallet-api'de.
  // Her seviye yazılmak zorunda, eksikse uygulama AÇILMIYOR.
  //
  // IncomingTotal (ayın toplam girişi: yükleme ve gelen transfer) ve BalanceCaps
  // wallet-api'de de yazılı, ikisi de iki yolda sayılıyor. İki kopya AYNI kalmalı.
  //
  // Kimliği tespit edilmemiş seviyelerin (Unknown, Unverified) tutarları yasal tavan:
  // ayda toplam yükleme ve bakiye 5.500 TL'yi aşamaz (MASAK Genel Tebliği Sıra No 5,
  // 2.2.11). Verified ve Contracted'ın tutarları risk kararı, yasal tavanları yok.
  "Kyc": {
    "MonthlyLimits": {
      "Unknown": { "Withdrawal": 0, "Deposit": 0, "IncomingTotal": 0 },
      "Unverified": { "Withdrawal": 0, "Deposit": 5500, "IncomingTotal": 5500 },
      "Verified": { "Withdrawal": 25000, "Deposit": 50000, "IncomingTotal": 100000 },
      "Contracted": { "Withdrawal": 1000000, "Deposit": 1000000, "IncomingTotal": 2000000 }
    },
    // Bakiye tavanı, bütün cüzdanların toplamı. Yalnızca kimliği tespit edilmemiş
    // seviyelerde ve onlarda zorunlu.
    "BalanceCaps": {
      "Unknown": 0,
      "Unverified": 5500
    }
  },

  // Havalenin göndereninin hesap sahibi olup olmadığı onboarding'e soruluyor; token bu
  // istemcinin. BaseUrl ve ClientSecret ortamdan gelir.
  "Keycloak": {
    "Realm": "hiwallet",
    "ClientId": "wallet-consumer"
  },

  // Çekim tarifesi. Transfers altında DEĞİL: çekim bir transfer değil, para
  // sistemden çıkıyor ve alan cüzdan yok (decisions.md madde 13, adım 4.8).
  //
  // Yalnızca BU uygulamada duruyor: çekim komutlarını işleyen tek yer burası.
  // wallet-api'ye de konsaydı iki kopya olur ve ayrıştıklarında müşteri
  // beklediğinden farklı öderdi.
  //
  // Bölüm eksikse uygulama AÇILMIYOR — sessizce komisyonsuz ve limitsiz
  // çalışmaktansa patlaması iyi.
  "Withdrawals": {
    // Komisyon istenen tutara EK olarak düşülür: müşteri 100 isterse cüzdandan
    // 102 çıkar, bankaya 100 gider.
    "Commission": {
      "Rate": 0.02,
      "Minimum": 2,
      "Maximum": 100
    },
    // Limit cüzdandan çıkan TOPLAMA uygulanır, komisyon dahil
    // (decisions.md madde 22).
    "Limit": {
      "PerTransaction": 20000,
      "Daily": 50000
    }
  },

  // Sağlayıcı ücret tarifeleri (decisions.md madde 10). Bizim MÜŞTERİDEN aldığımız
  // komisyon değil, SAĞLAYICININ bizden aldığı ücret — biri gelir, öbürü gider ve
  // ledger'da ayrı hesaplarda durur, netleştirilmez.
  //
  // Buradaki tutar bir BEKLENTİ; provider_fees.expected_amount'a yazılıyor ve
  // ledger'a asla girmiyor. Gerçekleşen tutar Net modelde settlement'ta, Invoiced
  // modelde faturada belli oluyor.
  //
  // Bölüm eksikse uygulama AÇILMIYOR: ücretsiz sayılan bir sağlayıcı bütün giderini
  // raporlardan siler ve fatura geldiğinde "beklenen toplam sıfır" ile uyuşmazlık
  // üretir (madde 11).
  //
  // Anahtarlar ledger_accounts.provider ile AYNI olmak zorunda (madde 14).
  "Providers": {
    // Kart sağlayıcısı: ücreti settlement anında kesiyor, oran + işlem başına sabit.
    // FundType kart: bu kanaldan gelen para IBAN'a çıkamıyor (madde 36).
    "stripe-fake": {
      "FeeSettlement": "Net",
      "FundType": "Card",
      "Fee": {
        "Rate": 0.029,
        "Fixed": 0.30
      }
    },
    // Banka: ücreti dönem sonu faturasıyla alıyor, işlem başına sabit.
    // FundType nakit: hesaba gelen havale çekilebilen tek kova.
    "bank-fake": {
      "FeeSettlement": "Invoiced",
      "FundType": "Cash",
      "Fee": {
        "Rate": 0.0,
        "Fixed": 1.50
      }
    }
  }
}
