{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ConnectionStrings .env / User Secrets'tan gelir, buraya YAZILMAZ (baseline.md madde 1).

  // Personel promo'su (decisions.md madde 37): çalışanın tek seferde verebileceği en
  // fazla tutar, para birimi başına. Daha büyük tutar kampanyayla verilir.
  "Promos": {
    "StaffGrant": {
      "MaxAmount": {
        "TRY": 500
      }
    }
  },

  // Havalenin gönderileceği toplama hesabı: bütün müşteriler aynı IBAN'a gönderiyor,
  // açıklamadaki hesap numarası paranın kime ait olduğunu söylüyor. Canlıda bankayla
  // yapılan sözleşmedeki hesap; buradaki sahte bankanın örnek IBAN'ı.
  "Deposits": {
    "Iban": "TR280009900000000000123456",
    "AccountHolder": "Hive Elektronik Para A.Ş.",
    "Currency": "TRY"
  },

  "Authentication": {
    // Bireysel hesabı açan ve seviyeyi yükselten servisin Keycloak istemcisi; token'ın
    // azp'sinde bu ad arıyor (Setup/OnboardingAccess.cs).
    "OnboardingClientId": "onboarding"
  },

  // Doğrulama seviyesine göre AYLIK limitler, günlük ve işlem başına tarifenin üstüne.
  // Yalnızca bireysel hesaba uygulanıyor. Tutar cüzdandan çıkan toplam, komisyon dahil;
  // hesabın kendi cüzdanları arasındaki aktarım sayılmıyor.
  //
  // Her seviye ve her hareket yazılmak zorunda, eksikse uygulama AÇILMIYOR. Çekim ve
  // yükleme limiti burada değil, onları işleyen wallet-consumer'da.
  //
  // IncomingTotal (ayın toplam girişi: yükleme ve gelen transfer) ve BalanceCaps
  // wallet-consumer'da da yazılı, ikisi de iki yolda sayılıyor. İki kopya AYNI kalmalı.
  //
  // Kimliği tespit edilmemiş seviyelerin (Unknown, Unverified) tutarları yasal tavan:
  // ayda toplam yükleme ve bakiye 5.500 TL'yi aşamaz (MASAK Genel Tebliği Sıra No 5,
  // 2.2.11). Verified ve Contracted'ın tutarları risk kararı, yasal tavanları yok.
  "Kyc": {
    "MonthlyLimits": {
      // Kayıt bitti, kimlik doğrulanmadı: hiçbir hareket yok.
      "Unknown": { "IncomingTransfer": 0, "OutgoingTransfer": 0, "Payment": 0, "Deposit": 0, "IncomingTotal": 0 },
      // Telefon ve nüfus kaydı: para alabiliyor ve işyerine ödeyebiliyor, başka birine
      // gönderemiyor. Deposit (yükleme) wallet-consumer'ın tarifesiyle aynı olmak zorunda:
      // kartla yüklemenin payı burada, havale orada kontrol ediliyor.
      "Unverified": { "IncomingTransfer": 5500, "OutgoingTransfer": 0, "Payment": 5500, "Deposit": 5500, "IncomingTotal": 5500 },
      "Verified": { "IncomingTransfer": 50000, "OutgoingTransfer": 25000, "Payment": 50000, "Deposit": 50000, "IncomingTotal": 100000 },
      "Contracted": { "IncomingTransfer": 1000000, "OutgoingTransfer": 1000000, "Payment": 1000000, "Deposit": 1000000, "IncomingTotal": 2000000 }
    },
    // Bakiye tavanı, bütün cüzdanların toplamı. Yalnızca kimliği tespit edilmemiş
    // seviyelerde ve onlarda zorunlu.
    "BalanceCaps": {
      "Unknown": 0,
      "Unverified": 5500
    }
  },

  "Transfers": {
    // Tarifesi tanımlı olmayan tip limitsiz ve komisyonsuz demektir.
    // Buradaki anahtarlar TransferType değerleriyle birebir eşleşmeli; eşleşmezse
    // uygulama startup'ta patlar (fail fast) — yazım hatası sessizce "tarife yok"a
    // dönüşmemeli.
    "Limits": {
      "P2P": {
        "PerTransaction": 10000,
        "Daily": 25000
      },
      "P2B": {
        "PerTransaction": 25000,
        "Daily": 50000
      },
      "B2P": {
        "PerTransaction": 50000,
        "Daily": 200000
      },
      "B2B": {
        "PerTransaction": 250000,
        "Daily": 1000000
      },
      "Payment": {
        "PerTransaction": 50000,
        "Daily": 200000
      }
    },

    // Rate oran (0.02 = %2). Komisyon ayrı bir transfer değil, aynı atomik işlemin
    // ek bacağı (overview.md madde 4).
    "Commissions": {
      "Payment": {
        "Rate": 0.02,
        "Minimum": 0.50,
        "Maximum": 500
      },
      "B2B": {
        "Rate": 0.005,
        "Maximum": 1000
      }
    }
  }
}
