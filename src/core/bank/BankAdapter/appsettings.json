{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Bank": {
    // BaseUrl, Provider ve ConnectionStrings .env / User Secrets'tan gelir, buraya
    // YAZILMAZ (baseline.md madde 1). Provider bankanın bizdeki kodu ve wallet'taki
    // sistem hesaplarının provider'ıyla aynı olmak zorunda.
    "RequestTimeout": "00:00:10",

    "Reconciliation": {
      // Callback asıl yol; bu tarama bir KONTROL ve seyrek koşuyor
      // (decisions.md madde 35). Kapatılamaz — yalnızca aralığı ayarlanır.
      "Interval": "04:00:00",

      // Yalnızca bu süreden uzundur cevapsız kalanlar sorulur. Callback hattı
      // sağlıklıyken tarama boş döner; dolu dönmeye başlaması alarm sinyali.
      "StaleAfter": "00:15:00",

      "BatchSize": 100
    },

    "DepositReconciliation": {
      // Gelen havalelerin bildirimi asıl yol; hesap hareketi taraması KONTROL.
      // Kapatılamaz, yalnızca aralığı ayarlanır.
      "Interval": "04:00:00",

      // Bundan yeni havaleler taranmıyor: bildirimleri yolda olabilir.
      "StaleAfter": "00:15:00",

      // Ne kadar geriye bakıldığı; aralıktan uzun ki koşulmayan bir tur da kapsansın.
      "Lookback": "3.00:00:00"
    }
  }
}
