{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ConnectionStrings ve Providers:*:WebhookSecret .env / User Secrets'tan gelir,
  // buraya YAZILMAZ (baseline.md madde 1).

  "RateLimiting": {
    // Sağlayıcı BAŞINA. Kimliği doğrulanmamış bir uçta HMAC hesabı CPU harcatır.
    "Webhooks": {
      "BurstSize": 100,
      "SustainedPerMinute": 600
    }
  }
}
