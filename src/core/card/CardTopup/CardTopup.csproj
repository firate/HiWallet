<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- Kartla yüklemenin ömrü: ödemeyi başlatır, sağlayıcıda açar, sonucunu izler ve
         wallet'a bildirir. Kendi veritabanı; wallet tablolarına DOKUNMAZ. Limit payını
         wallet-api'den ister, parayı wallet-consumer yazar. -->

    <PropertyGroup>
        <RootNamespace>HiWallet.CardTopup</RootNamespace>
        <AssemblyName>HiWallet.CardTopup</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="FluentValidation"/>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions"/>
        <PackageReference Include="AspNetCore.HealthChecks.NpgSql"/>
        <PackageReference Include="Microsoft.Extensions.Http.Resilience"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\shared\Shared.Contracts\Shared.Contracts.csproj"/>
        <ProjectReference Include="..\..\..\shared\Shared.Infrastructure\Shared.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HiWallet.UnitTests"/>
        <InternalsVisibleTo Include="HiWallet.IntegrationTests"/>
    </ItemGroup>

</Project>
