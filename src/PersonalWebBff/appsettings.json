{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Keycloak'taki istemci. Issuer ve gizli anahtar ortamdan gelir.
  "Authentication": {
    "ClientId": "personal-web"
  },

  // İç servislerin adresi ortamdan gelir (compose: InternalServices__WalletApi__BaseUrl).
  // Eksikse uygulama açılmaz.
  "InternalServices": {
    "WalletApi": {
      "RequestTimeout": "00:00:10"
    },
    "WithdrawalOrchestrator": {
      "RequestTimeout": "00:00:10"
    }
  },

  // In-memory limiter: çok instance'ta efektif limit instance BAŞINA uygulanır.
  // Bilinçli sınırlama (decisions.md madde 12).
  "RateLimiting": {
    "Client": {
      "BurstSize": 20,
      "SustainedPerMinute": 60
    },
    "Withdrawals": {
      "BurstSize": 10,
      "SustainedPerMinute": 30
    }
  }
}
