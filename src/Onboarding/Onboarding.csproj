<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- Müşteri kaydı ve kimlik doğrulaması. Kişisel veri (e-posta, telefon, TCKN, doğum
         tarihi, onaylar) burada ve KENDİ veritabanında; ledger'la aynı yerde durmuyor.
         Wallet'a yalnızca "hesabı aç" ve "seviyeyi yükselt" gidiyor. -->

    <ItemGroup>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="FluentValidation"/>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions"/>
        <PackageReference Include="AspNetCore.HealthChecks.NpgSql"/>
        <PackageReference Include="MailKit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shared\Shared.Infrastructure\Shared.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HiWallet.UnitTests"/>
        <InternalsVisibleTo Include="HiWallet.IntegrationTests"/>
    </ItemGroup>

</Project>
