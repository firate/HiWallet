{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ConnectionStrings ve gizli anahtar (Keycloak:ClientSecret) ortamdan gelir, buraya
  // YAZILMAZ (baseline.md madde 1).

  // Yalnızca çalışanların Keycloak'ının token'ı; issuer ve anahtar adresi ortamdan.
  "Authentication": {
    "Audience": "hiwallet-api"
  },

  // Çalışanları ve rolleri yöneten istemci. Servis hesabının yalnızca çalışanların
  // realm'inde kullanıcı ve rol yönetme yetkisi var.
  "Keycloak": {
    "Realm": "hiwallet-staff",
    "ClientId": "staff-admin",
    // Davet bağlantısı: parola ve OTP kurulunca çalışan panele dönüyor. Panelin adresi
    // (RedirectUri) ortamdan.
    "Invitation": {
      "ClientId": "backoffice",
      "LifespanHours": 72
    }
  },

  "StaffAdmin": {
    // İlk yöneticinin adresi (AdminEmail) ortamdan.
    "Bootstrap": {
      "AdminRoleName": "Personel yöneticisi"
    }
  }
}
