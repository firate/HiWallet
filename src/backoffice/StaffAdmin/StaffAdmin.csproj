<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- Personel yönetimi: çalışanlar, roller ve rollerin izinleri. Çalışanların
         Keycloak'ına kendi servis hesabıyla gidiyor; kim kime ne verdi kendi veritabanında.
         Wallet'a, ledger'a ve müşterilerin Keycloak'ına dokunmuyor. -->

    <ItemGroup>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="FluentValidation"/>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions"/>
        <PackageReference Include="AspNetCore.HealthChecks.NpgSql"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shared\Shared.Infrastructure\Shared.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HiWallet.UnitTests"/>
        <InternalsVisibleTo Include="HiWallet.IntegrationTests"/>
    </ItemGroup>

</Project>
