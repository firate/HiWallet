{
  // dotnet run ile yerelde: çalışanların Keycloak'ı compose'dan, host'a açılan portunda.
  "Authentication": {
    "RequireHttpsMetadata": false,
    "Staff": {
      "Issuer": "http://localhost:8107/realms/hiwallet-staff"
    }
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:8107",
    "Invitation": {
      "RedirectUri": "http://localhost:8099/"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
