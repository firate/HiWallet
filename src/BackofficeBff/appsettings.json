{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Çalışanların realm'indeki istemci. Issuer ve gizli anahtar ortamdan gelir.
  "Authentication": {
    "ClientId": "backoffice"
  },

  // İç servislerin adresi ortamdan gelir. Eksikse uygulama açılmaz.
  "InternalServices": {
    "WalletApi": {
      "RequestTimeout": "00:00:10"
    },
    "WithdrawalOrchestrator": {
      "RequestTimeout": "00:00:10"
    }
  },

  // In-memory limiter: çok instance'ta efektif limit instance BAŞINA uygulanır.
  // Bilinçli sınırlama (decisions.md madde 12).
  "RateLimiting": {
    "Client": {
      "BurstSize": 50,
      "SustainedPerMinute": 300
    },
    "Withdrawals": {
      "BurstSize": 10,
      "SustainedPerMinute": 30
    }
  }
}
