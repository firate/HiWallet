<Project Sdk="Microsoft.NET.Sdk">

    <!-- Birden fazla servisin paylaştığı altyapı. Şu an yalnızca RabbitMQ bağlantısı
         ve topup topolojisi: hem publish eden (topup-webhook) hem tüketen
         (wallet-service) aynı exchange/queue adlarını ve argümanlarını kullanmak
         zorunda — iki yerde ayrı yazılsaydı ilk sapmada broker
         PRECONDITION_FAILED verirdi. -->

    <ItemGroup>
        <!-- Tüketicilerin hepsi ASP.NET Core uygulaması. FrameworkReference ile
             Options/Configuration/DI/Logging/HealthChecks paylaşılan framework'ten
             geliyor; ayrı paket sürümü yönetmeye gerek kalmıyor. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="RabbitMQ.Client"/>
        <!-- Yalnızca advisory lock için (Jobs/JobLease). EF Core BURAYA GİRMİYOR:
             job'ın kendi işi kendi DbContext'iyle, kendi bağlantısında koşuyor. -->
        <PackageReference Include="Npgsql"/>

        <PackageReference Include="OpenTelemetry.Extensions.Hosting"/>
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.Http"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime"/>
        <PackageReference Include="Npgsql.OpenTelemetry"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shared.Contracts\Shared.Contracts.csproj"/>
    </ItemGroup>

    <!-- Kilit anahtarının süreçten sürece aynı üretildiği doğrulanabilsin diye
         (JobLease.KeyFor). Anahtar public yüzey DEĞİL: dışarıdan çağrılacak bir
         şey değil, yalnızca sınanacak bir şey. -->
    <ItemGroup>
        <InternalsVisibleTo Include="HiWallet.IntegrationTests"/>
    </ItemGroup>

</Project>
