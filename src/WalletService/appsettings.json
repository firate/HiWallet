{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // In-memory limiter: çok instance'ta efektif limit instance BAŞINA uygulanır.
  // Bilinçli sınırlama (decisions.md madde 12).
  "RateLimiting": {
    "Transfers": {
      "BurstSize": 20,
      "SustainedPerMinute": 60
    }
  },

  // ConnectionStrings .env / User Secrets'tan gelir, buraya YAZILMAZ (baseline.md madde 1).

  "Transfers": {
    // Tarifesi tanımlı olmayan tip limitsiz ve komisyonsuz demektir.
    // Buradaki anahtarlar TransferType değerleriyle birebir eşleşmeli; eşleşmezse
    // uygulama startup'ta patlar (fail fast) — yazım hatası sessizce "tarife yok"a
    // dönüşmemeli.
    "Limits": {
      "P2P": {
        "PerTransaction": 10000,
        "Daily": 25000
      },
      "P2B": {
        "PerTransaction": 25000,
        "Daily": 50000
      },
      "B2P": {
        "PerTransaction": 50000,
        "Daily": 200000
      },
      "B2B": {
        "PerTransaction": 250000,
        "Daily": 1000000
      },
      "Payment": {
        "PerTransaction": 50000,
        "Daily": 200000
      }
    },

    // Rate oran (0.02 = %2). Komisyon ayrı bir transfer değil, aynı atomik işlemin
    // ek bacağı (overview.md madde 4).
    "Commissions": {
      "Payment": {
        "Rate": 0.02,
        "Minimum": 0.50,
        "Maximum": 500
      },
      "B2B": {
        "Rate": 0.005,
        "Maximum": 1000
      }
    }
  }
}
