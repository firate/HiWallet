{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Kart sağlayıcısı. Provider wallet'taki ledger_accounts.provider ile aynı değer;
  // ProviderUrl ortamdan geliyor.
  "CardTopups": {
    "Provider": "stripe-fake",
    "SessionLifetime": "00:15:00",
    "Scan": {
      "Interval": "00:01:00",
      "CreatedStaleAfter": "00:05:00",
      "ExpiryGrace": "00:01:00"
    }
  }
}
