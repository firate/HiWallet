{
  // dotnet run ile yerelde: bağımlılıklar compose'dan, host'a açılan portlarında.
  "Authentication": {
    "Issuer": "http://localhost:8101/realms/hiwallet",
    "Audience": "hiwallet-api",
    "RequireHttpsMetadata": false,
    // Çalışanların Keycloak'ı ayrı kurulum, kendi portunda.
    "Staff": {
      "Issuer": "http://localhost:8107/realms/hiwallet-staff",
      // Çalışanın izinleri her istekte personel yönetiminden.
      "StaffAdminUrl": "http://localhost:8108"
    }
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:8101"
  },
  "InternalServices": {
    "WalletApi": { "BaseUrl": "http://localhost:8091" }
  },
  // Mailpit düz SMTP konuşuyor.
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "UseStartTls": false,
    "From": "HiWallet <kayit@hiwallet.test>"
  },
  "Sms": { "BaseUrl": "http://localhost:8104" },
  "PopulationRegistry": { "BaseUrl": "http://localhost:8105" },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
