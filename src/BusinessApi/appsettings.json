{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Bu ön API yalnızca kendisi için verilmiş token'ı kabul ediyor: entegrasyon
  // istemcisinin token'ının hedef kitlesinde "business-api" var. Issuer ortamdan gelir.
  "Authentication": {
    "Audience": "business-api"
  },

  // İç servislerin adresi ortamdan gelir (compose: InternalServices__WalletApi__BaseUrl).
  // Eksikse uygulama açılmaz.
  "InternalServices": {
    "WalletApi": {
      "RequestTimeout": "00:00:10"
    },
    "WithdrawalOrchestrator": {
      "RequestTimeout": "00:00:10"
    }
  },

  // In-memory limiter: çok instance'ta efektif limit instance BAŞINA uygulanır.
  // Bilinçli sınırlama (decisions.md madde 12).
  "RateLimiting": {
    "Client": {
      "BurstSize": 100,
      "SustainedPerMinute": 600
    },
    "Withdrawals": {
      "BurstSize": 10,
      "SustainedPerMinute": 30
    }
  }
}
