{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ConnectionStrings ve RabbitMq .env / User Secrets'tan gelir, buraya YAZILMAZ
  // (baseline.md madde 1).

  // Çekim tarifesi. Transfers altında DEĞİL: çekim bir transfer değil, para
  // sistemden çıkıyor ve alan cüzdan yok (decisions.md madde 13, adım 4.8).
  //
  // Yalnızca BU uygulamada duruyor: çekim komutlarını işleyen tek yer burası.
  // wallet-api'ye de konsaydı iki kopya olur ve ayrıştıklarında müşteri
  // beklediğinden farklı öderdi.
  //
  // Bölüm eksikse uygulama AÇILMIYOR — sessizce komisyonsuz ve limitsiz
  // çalışmaktansa patlaması iyi.
  "Withdrawals": {
    // Komisyon istenen tutara EK olarak düşülür: müşteri 100 isterse cüzdandan
    // 102 çıkar, bankaya 100 gider.
    "Commission": {
      "Rate": 0.02,
      "Minimum": 2,
      "Maximum": 100
    },
    // Limit cüzdandan çıkan TOPLAMA uygulanır, komisyon dahil
    // (decisions.md madde 22).
    "Limit": {
      "PerTransaction": 20000,
      "Daily": 50000
    }
  },

  // Sağlayıcı ücret tarifeleri (decisions.md madde 10). Bizim MÜŞTERİDEN aldığımız
  // komisyon değil, SAĞLAYICININ bizden aldığı ücret — biri gelir, öbürü gider ve
  // ledger'da ayrı hesaplarda durur, netleştirilmez.
  //
  // Buradaki tutar bir BEKLENTİ; provider_fees.expected_amount'a yazılıyor ve
  // ledger'a asla girmiyor. Gerçekleşen tutar Net modelde settlement'ta, Invoiced
  // modelde faturada belli oluyor.
  //
  // Bölüm eksikse uygulama AÇILMIYOR: ücretsiz sayılan bir sağlayıcı bütün giderini
  // raporlardan siler ve fatura geldiğinde "beklenen toplam sıfır" ile uyuşmazlık
  // üretir (madde 11).
  //
  // Anahtarlar ledger_accounts.provider ile AYNI olmak zorunda (madde 14).
  "Providers": {
    // Kart sağlayıcısı: ücreti settlement anında kesiyor, oran + işlem başına sabit.
    "stripe-fake": {
      "FeeSettlement": "Net",
      "Fee": {
        "Rate": 0.029,
        "Fixed": 0.30
      }
    },
    // Banka: ücreti dönem sonu faturasıyla alıyor, işlem başına sabit.
    "bank-fake": {
      "FeeSettlement": "Invoiced",
      "Fee": {
        "Rate": 0.0,
        "Fixed": 1.50
      }
    }
  }
}
