# HiWallet — ortam değişkenleri şablonu
#
# Bu dosya commit'lenir ve YALNIZCA placeholder içerir. Gerçek değerler `.env`'e
# yazılır, o da .gitignore'da (baseline.md madde 1: secret koda gömülmez).
#
# Kullanım:
#   cp .env.example .env    ve <DOLDUR> yazan yerleri doldur
#
# DİKKAT: .env dosyasını yalnızca Docker Compose otomatik okur. Rider'dan ya da
# `dotnet run` ile çalıştırırken .NET bu dosyaya BAKMAZ — orada User Secrets
# kullanılır (`dotnet user-secrets set ...`). İkisi aynı değerleri taşır.
#
# DİKKAT 2: `;` içeren değerler TIRNAK İÇİNDE olmak zorunda. Connection string'ler
# noktalı virgülle ayrılıyor ve `. ./.env` ile kabuğa yüklendiğinde `;` komut
# ayracı sayılıyor — tırnaksız yazarsan değişkene yalnızca ilk parça (`Host=...`)
# atanır, gerisi sessizce ayrı değişken olur. Compose tırnakları zaten soyuyor,
# yani tırnak iki tarafta da doğru çalışıyor.

# ---------------------------------------------------------------------------
# Homelab
# ---------------------------------------------------------------------------
# Tailscale üzerinden erişilir; ağ üyeliği olmadan hiçbir port açık değildir.
HOMELAB_HOST=homelab

# ---------------------------------------------------------------------------
# PostgreSQL — wallet-service
# ---------------------------------------------------------------------------
# İki ayrı rol, iki ayrı bağlantı. Gerekçe: ledger_entries üzerindeki
# REVOKE UPDATE, DELETE yalnızca tablo sahibi OLMAYAN bir role işler
# (sahiplik yetkisi örtüktür, revoke edilemez).
#
#   wallet_owner -> EF migration koşar, tabloların sahibi
#   wallet_app   -> uygulama runtime, ledger_entries'i güncelleyemez

# Uygulamanın kullandığı bağlantı. ConnectionStrings__ öneki ASP.NET Core
# konfigürasyonuna doğrudan bağlanır, ek kod gerekmez.
ConnectionStrings__Wallet="Host=homelab;Port=5432;Database=hiwallet_wallet;Username=wallet_app;Password=<DOLDUR>"

# Yalnızca `dotnet ef database update` için. Uygulama bunu KULLANMAZ.
ConnectionStrings__WalletOwner="Host=homelab;Port=5432;Database=hiwallet_wallet;Username=wallet_owner;Password=<DOLDUR>"

# Şema doğrulaması için tek kullanımlık veritabanı. Doğrulama bitince düşürülür.
SCHEMA_CHECK_CONNECTION="Host=homelab;Port=5432;Database=hiwallet_schema_check;Username=wallet_owner;Password=<DOLDUR>"

# ---------------------------------------------------------------------------
# Henüz kullanılmıyor — adım 3'te (top-up hattı) devreye girer
# ---------------------------------------------------------------------------
RabbitMq__Host=homelab
RabbitMq__Port=5672
RabbitMq__Username=<DOLDUR>
RabbitMq__Password=<DOLDUR>

# ---------------------------------------------------------------------------
# OpenTelemetry — baseline.md madde 2 ve 3
# ---------------------------------------------------------------------------
# Bu isimleri OTel SDK'sı kendi okur, bizim kod yazmamız gerekmiyor.
# Homelab Collector'ı: gRPC 4317, HTTP 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://homelab:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=hiwallet-wallet-service
