# HiWallet — ortam değişkenleri şablonu
#
# Bu dosya commit'lenir ve YALNIZCA placeholder içerir. Gerçek değerler `.env`'e
# yazılır, o da .gitignore'da (baseline.md madde 1: secret koda gömülmez).
#
# Kullanım:
#   cp .env.example .env    ve <DOLDUR> yazan yerleri doldur
#
# DİKKAT: .env dosyasını yalnızca Docker Compose otomatik okur. Rider'dan ya da
# `dotnet run` ile çalıştırırken .NET bu dosyaya BAKMAZ — orada User Secrets
# kullanılır (`dotnet user-secrets set ...`). İkisi aynı değerleri taşır.
#
# DİKKAT 2: `;` içeren değerler TIRNAK İÇİNDE olmak zorunda. Connection string'ler
# noktalı virgülle ayrılıyor ve `. ./.env` ile kabuğa yüklendiğinde `;` komut
# ayracı sayılıyor — tırnaksız yazarsan değişkene yalnızca ilk parça (`Host=...`)
# atanır, gerisi sessizce ayrı değişken olur. Compose tırnakları zaten soyuyor,
# yani tırnak iki tarafta da doğru çalışıyor.

# ---------------------------------------------------------------------------
# PostgreSQL — wallet-service
# ---------------------------------------------------------------------------
# İki ayrı rol, iki ayrı bağlantı. Gerekçe: ledger_entries üzerindeki
# REVOKE UPDATE, DELETE yalnızca tablo sahibi OLMAYAN bir role işler
# (sahiplik yetkisi örtüktür, revoke edilemez).
#
#   wallet_owner -> EF migration koşar, tabloların sahibi
#   wallet_app   -> uygulama runtime, ledger_entries'i güncelleyemez

# Uygulamanın kullandığı bağlantı. ConnectionStrings__ öneki ASP.NET Core
# konfigürasyonuna doğrudan bağlanır, ek kod gerekmez.
ConnectionStrings__Wallet="Host=localhost;Port=5432;Database=hiwallet_wallet;Username=wallet_app;Password=<DOLDUR>"

# Yalnızca `dotnet ef database update` için. Uygulama bunu KULLANMAZ.
ConnectionStrings__WalletOwner="Host=localhost;Port=5432;Database=hiwallet_wallet;Username=wallet_owner;Password=<DOLDUR>"

# Integration testlerin veritabanı. Her test koşusu burada kendi schema'sını açıp
# migration'ı uygular, sonunda düşürür — izolasyon böyle sağlanıyor, Docker gerekmiyor.
ConnectionStrings__IntegrationTests="Host=localhost;Port=5432;Database=hiwallet_schema_check;Username=wallet_owner;Password=<DOLDUR>"

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------
# `docker compose up` compose İÇİNDEKİ postgres'e bağlanır, yukarıda tanımlı dış
# veritabanına değil. Oradaki connection string'lerden bağımsız; compose kendi
# bağlantısını bu parolalardan kurar.
POSTGRES_PASSWORD=<DOLDUR>
WALLET_OWNER_PASSWORD=<DOLDUR>
WALLET_APP_PASSWORD=<DOLDUR>

# topup-webhook kendi veritabanında (hiwallet_topup), TEK rol ile. Wallet'taki
# ikili kurulumun sebebi ledger_entries üzerindeki REVOKE'tu; burada append-only
# zorlanacak bir tablo yok. Aynısı aşağıdaki iki servis için de geçerli.
TOPUP_APP_PASSWORD=<DOLDUR>

# withdrawal-orchestrator kendi veritabanında (hiwallet_withdrawal). Wallet
# tablolarına erişimi YOK — saga'nın anlamı buna bağlı (decisions.md madde 7 ve 33).
WITHDRAWAL_APP_PASSWORD=<DOLDUR>

# bank-service sahte ama sınırı gerçek: kendi veritabanı (hiwallet_bank),
# wallet'ı göremiyor. Gerçek bir banka da göremezdi.
BANK_APP_PASSWORD=<DOLDUR>

# Host portları. Varsayılanlar alışıldık portlardan (8080, 5432, 5672) bilerek
# kaçıyor: geliştirme makinesinde o portlarda çoğu zaman başka bir şey duruyor.
# Kendi makinende boşlarsa değiştirebilirsin.
WALLET_HOST_PORT=8091
TOPUP_HOST_PORT=8092
WITHDRAWAL_HOST_PORT=8093
# Sahte bankanın senaryo ucu. Gerçek entegrasyonda bu port da bu servis de olmayacak.
BANK_HOST_PORT=8094
POSTGRES_HOST_PORT=5433
# Compose kendi RabbitMQ'sunu getiriyor. Makinede zaten bir broker varsa
# 5672/15672 dolu olur; çakışmasın diye 5673/15673.
RABBITMQ_HOST_PORT=5673
RABBITMQ_MGMT_HOST_PORT=15673

# ---------------------------------------------------------------------------
# RabbitMQ — top-up hattı
# ---------------------------------------------------------------------------
# İKİ AYRI KULLANIM, aynı değişkenler:
#   - `dotnet run` / `dotnet test` ile local'den: aşağıdaki Host'a bağlanılır.
#   - `docker compose up` ile: compose İÇİNDEKİ rabbitmq'ya bağlanılır ve bu
#     kullanıcı/parola onun ilk kullanıcısı olarak kurulur.
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__Username=<DOLDUR>
RabbitMq__Password=<DOLDUR>

# Kaç partition kuyruğu açılacağı. Aynı cüzdanın mesajları hep aynı kuyrukta,
# sıra orada korunuyor. Sonradan artırmak bir cüzdanı başka kuyruğa taşır —
# kuyruklar boşken yapılmalı.
RABBITMQ_PARTITION_COUNT=4

# ---------------------------------------------------------------------------
# Zamanlanmış işler
# ---------------------------------------------------------------------------
# Varsayılanlar ÜRETİM değerleri; aşağıda yazılı olanlar zaten compose'un
# varsayılanı, tanımlamana gerek yok.
#
# İlk tur beklemeden koşmuyor (ScheduledJob): dağıtımda ayağa kalkan her instance
# aynı anda tarama başlatmasın diye. Bunun bedeli, ilk turu gözle görmek için bir
# aralık beklemek. Doğrulama koşusunda kısalt, sonra geri al:
#
#   JOBS_RECONCILIATION_INTERVAL=00:00:30
#   JOBS_BUSINESS_SUMMARY_INTERVAL=00:00:30
#   JOBS_STUCK_SAGA_SCAN_INTERVAL=00:00:30
#
# JOBS_RECONCILIATION_INTERVAL=06:00:00      # wallet-consumer
# JOBS_BUSINESS_SUMMARY_INTERVAL=01:00:00    # wallet-consumer
# JOBS_STUCK_SAGA_SCAN_INTERVAL=00:05:00     # withdrawal-orchestrator

# ---------------------------------------------------------------------------
# Sahte banka
# ---------------------------------------------------------------------------
# Senaryosu kurulmamış transferlerin sonucu: Success | PermanentFailure |
# TransientFailure | DelayedSuccess.
#
# Varsayılan Success. Telafi yolunu tüm sistemde göstermek istersen
# PermanentFailure yap — o zaman her çekim reddedilir ve para üç bacaklı ters
# kayıtla cüzdana geri döner. Tek bir çekimi hedeflemek için servis ayakken:
#   POST http://localhost:8094/v1/scenarios
#   {"sagaId":"...","outcome":"PermanentFailure"}
BANK_DEFAULT_OUTCOME=Success

# ---------------------------------------------------------------------------
# Webhook imzaları
# ---------------------------------------------------------------------------
# Sağlayıcı ile paylaşılan HMAC-SHA256 secret'ı. Sahte webhook'u engelleyen tek
# şey bu. Gerçekte sağlayıcının panelinden alınır; fake sağlayıcılarda değeri sen
# belirliyorsun (uzun ve rastgele olsun).
STRIPE_FAKE_WEBHOOK_SECRET=<DOLDUR>
BANK_FAKE_WEBHOOK_SECRET=<DOLDUR>

# ---------------------------------------------------------------------------
# OpenTelemetry — baseline.md madde 2 ve 3
# ---------------------------------------------------------------------------
# Bu isimleri OTel SDK'sı kendi okur, bizim kod yazmamız gerekmiyor.
# Collector'ın standart portları: gRPC 4317, HTTP 4318.
#
# Compose bir Collector GETİRMİYOR — telemetri varsa dışarıdakine gider.
# Collector container'ların dışında, Docker host'unda koşuyorsa:
#     OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
#
# Boş bırakılırsa exporter hiç eklenmez, uygulama sessizce çalışır. Collector'ın
# yoksa boş bırak — varsayılan bu.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# OTEL_SERVICE_NAME BİLEREK tanımlı değil: her servis kendi adını veriyor
# (hiwallet-wallet-api, hiwallet-topup-webhook, hiwallet-wallet-consumer,
# hiwallet-withdrawal-orchestrator, hiwallet-bank-service). Burada tanımlarsan
# hepsini aynı isimle etiketler ve Tempo'da servisleri ayırt edemezsin. Compose
# zaten servis başına sabit değer geçiyor.
