{
  "realm": "hiwallet",
  "displayName": "HiWallet",
  "displayNameHtml": "<div class=\"hiwallet-brand\">Hi<span>Wallet</span></div>",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "passwordPolicy": "length(8)",
  "loginTheme": "hiwallet",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "tr",
    "en"
  ],
  "defaultLocale": "tr",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "kayit@hiwallet.test",
    "fromDisplayName": "HiWallet"
  },
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clients": [
    {
      "clientId": "personal-mobile-app",
      "name": "HiWallet bireysel mobil uygulama",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "hiwallet://oauth/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "hiwallet://oauth/logout"
      },
      "protocolMappers": [
        {
          "name": "personal-mobile-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "personal-mobile-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "hiwallet-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hiwallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "personal-web",
      "name": "HiWallet bireysel web uygulaması",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PERSONAL_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8102/signin-oidc",
        "http://localhost:5173/signin-oidc",
        "https://hiwallet-personal-web-bff.${PROXY_DOMAIN}/signin-oidc"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8102/signout-callback-oidc##http://localhost:5173/signout-callback-oidc##https://hiwallet-personal-web-bff.${PROXY_DOMAIN}/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "hiwallet-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hiwallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "hiwallet-cli",
      "name": "Elle deneme (yalnızca compose)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "personal-mobile-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "personal-mobile-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "hiwallet-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hiwallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "merchant-demo",
      "name": "Örnek işyeri entegrasyonu (yalnızca compose)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MERCHANT_DEMO_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "webOrigins": [
        "http://localhost:8091",
        "http://localhost:8093",
        "http://localhost:8098",
        "https://hiwallet-wallet-api.${PROXY_DOMAIN}",
        "https://hiwallet-withdrawal-orchestrator.${PROXY_DOMAIN}",
        "https://hiwallet-business-api.${PROXY_DOMAIN}"
      ],
      "protocolMappers": [
        {
          "name": "business-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "business-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "hiwallet-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hiwallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "api-docs",
      "name": "Scalar'da müşteri girişi (yalnızca compose)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8091/*",
        "http://localhost:8093/*",
        "http://localhost:8097/*",
        "https://hiwallet-wallet-api.${PROXY_DOMAIN}/*",
        "https://hiwallet-withdrawal-orchestrator.${PROXY_DOMAIN}/*",
        "https://hiwallet-personal-mobile-api.${PROXY_DOMAIN}/*",
        "http://localhost:8103/*",
        "https://hiwallet-onboarding.${PROXY_DOMAIN}/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "personal-mobile-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "personal-mobile-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "hiwallet-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hiwallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "onboarding",
      "name": "Kayıt servisi",
      "description": "Kaydı tamamlanan müşterinin kullanıcısını açar ve wallet-api'yi kendi kimliğiyle çağırır.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ONBOARDING_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "hiwallet-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hiwallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wallet-consumer",
      "name": "Wallet kuyruk tarafı",
      "description": "Havalenin göndereninin hesap sahibi olup olmadığını onboarding'e kendi kimliğiyle sorar.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${WALLET_CONSUMER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "hiwallet-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hiwallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-onboarding",
      "enabled": true,
      "serviceAccountClientId": "onboarding",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ]
}
