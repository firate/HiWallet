{
  "realm": "hiwallet-staff",
  "displayName": "HiWallet çalışanlar",
  "displayNameHtml": "<div class=\"hiwallet-brand\">Hi<span>Wallet</span> <small>Backoffice</small></div>",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "loginTheme": "hiwallet",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "tr",
    "en"
  ],
  "defaultLocale": "tr",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "personel@hiwallet.test",
    "fromDisplayName": "HiWallet Backoffice"
  },
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clients": [
    {
      "clientId": "backoffice",
      "name": "HiWallet backoffice paneli",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${BACKOFFICE_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8099/signin-oidc",
        "http://localhost:5174/signin-oidc",
        "https://hiwallet-backoffice-bff.${PROXY_DOMAIN}/signin-oidc",
        "http://localhost:8099/",
        "http://localhost:5174/",
        "https://hiwallet-backoffice-bff.${PROXY_DOMAIN}/"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8099/signout-callback-oidc##http://localhost:5174/signout-callback-oidc##https://hiwallet-backoffice-bff.${PROXY_DOMAIN}/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "hiwallet-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hiwallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "staff-admin",
      "name": "Personel yönetimi",
      "description": "Çalışanları, panelin rollerini ve rollerin izinlerini yönetir.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${STAFF_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-staff-admin",
      "enabled": true,
      "serviceAccountClientId": "staff-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "manage-realm",
          "view-realm"
        ]
      }
    }
  ]
}
